rules_version = '2';
// Grooveville security rules.
// Public: site settings and events marked "public".
// Founder or HNIC (access/{uid}.role == "founder" or "hnic"): everything.
// Company heads (listed in org/heads): approve people for their own company.
// Team members: only their own timesheet.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function accessDoc() { return get(/databases/$(database)/documents/access/$(request.auth.uid)); }
    function isFounder() {
      return signedIn()
        && exists(/databases/$(database)/documents/access/$(request.auth.uid))
        && accessDoc().data.role is string
        && accessDoc().data.role.lower().trim() in ["founder", "hnic"];
    }
    function headsDoc() { return get(/databases/$(database)/documents/org/heads); }
    function isHeadOf(b) {
      return signedIn()
        && exists(/databases/$(database)/documents/org/heads)
        && (b in headsDoc().data.heads)
        && request.auth.uid in headsDoc().data.heads[b];
    }
    function isAnyHead() {
      return signedIn()
        && exists(/databases/$(database)/documents/access/$(request.auth.uid))
        && accessDoc().data.get("heads", []).size() > 0;
    }

    // Public company page text and contact email
    match /settings/{doc} {
      allow read: if true;
      allow write: if isFounder();
    }

    // ---------- Grooveville Entertainment Studio ----------
    function isManager() {
      return signedIn()
        && exists(/databases/$(database)/documents/studioRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/studioRoles/$(request.auth.uid)).data.role == "manager";
    }
    function studioAdmin() { return isFounder() || isManager(); }
    function memberPath(show) { return /databases/$(database)/documents/shows/$(show)/members/$(request.auth.uid); }
    function hasShowRole(show, roles) { return signedIn() && exists(memberPath(show)) && get(memberPath(show)).data.role in roles; }
    function canView(show) { return studioAdmin() || hasShowRole(show, ["producer", "editor", "member"]); }
    function canEdit(show) { return studioAdmin() || hasShowRole(show, ["producer", "editor"]); }
    function canProduce(show) { return studioAdmin() || hasShowRole(show, ["producer"]); }
    function myEmail() { return request.auth.token.email.lower(); }
    function invitePath() { return /databases/$(database)/documents/invites/$(myEmail()); }
    function invitedAs(show, role) {
      return signedIn() && request.auth.token.email != null && exists(invitePath())
        && get(invitePath()).data.role == role && get(invitePath()).data.show == show;
    }

    // Show settings (name, YouTube channel, social links) are public so the Watch Live page can read them.
    match /shows/{show} {
      allow read: if true;
      allow create, delete: if studioAdmin();
      allow update: if studioAdmin()
        || (canProduce(show) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nextShow"]));

      match /members/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid) || canView(show);
        allow create: if studioAdmin()
          || (signedIn() && request.auth.uid == uid && request.resource.data.role in ["producer", "editor", "member"]
              && invitedAs(show, request.resource.data.role));
        allow update, delete: if studioAdmin();
      }
      match /episodes/{id} {
        allow read: if canView(show);
        allow write: if canEdit(show);
      }
      match /clips/{id} {
        allow read: if canView(show);
        allow create: if canEdit(show) || (hasShowRole(show, ["member"]) && request.resource.data.status == "suggested"
          && request.resource.data.createdBy == request.auth.uid);
        allow update: if canProduce(show)
          || (canEdit(show) && resource.data.status in ["suggested", "draft", "review", "rejected"]
              && request.resource.data.status in ["suggested", "draft", "review"]);
        allow delete: if canProduce(show);
      }
      match /jobs/{id} {
        allow read: if canEdit(show);
        allow create: if canEdit(show) && request.resource.data.status == "queued";
        allow update, delete: if canProduce(show);
      }
      match /calendar/{id} {
        allow read: if canView(show);
        allow write: if canProduce(show);
      }
    }
    // Department-wide Entertainment Managers. Only the owner adds them (or the person accepts an owner's invitation).
    match /studioRoles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || studioAdmin());
      allow create: if isFounder()
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == "manager" && invitedAs("", "manager"));
      allow update, delete: if isFounder();
    }
    // Invitations, keyed by lower-case email. Managers can invite to shows; only the owner can invite managers.
    match /invites/{email} {
      allow read: if studioAdmin() || (signedIn() && request.auth.token.email != null && myEmail() == email);
      allow create, update: if (isFounder() || (isManager() && request.resource.data.role in ["producer", "editor", "member"]))
        && request.resource.data.role in ["manager", "producer", "editor", "member"];
      allow delete: if studioAdmin() || (signedIn() && request.auth.token.email != null && myEmail() == email);
    }
    // AI processing worker heartbeat (written by the worker's service account, which bypasses these rules).
    match /studioWorker/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- Grooveville Music, TV and Charts ----------
    // Everyone can read what's published; only the founder (or HNIC) creates, edits, publishes, ranks or verifies.
    // MP3s and artwork live in Cloudflare R2; these documents only hold details and storage references.
    match /musicSongs/{id} {
      allow read: if resource.data.published == true || isFounder();
      allow write: if isFounder();
    }
    match /musicArtists/{id} {
      allow read: if resource.data.published == true || isFounder();
      allow write: if isFounder();
    }
    match /musicAlbums/{id} {
      allow read: if resource.data.published == true || isFounder();
      allow write: if isFounder();
    }
    match /musicPlaylists/{id} {
      allow read: if resource.data.published == true || isFounder();
      allow write: if isFounder();
    }
    match /tvVideos/{id} {
      allow read: if resource.data.published == true || isFounder();
      allow write: if isFounder();
    }
    match /tvPlaylists/{id} {
      allow read: if resource.data.published == true || isFounder();
      allow write: if isFounder();
    }
    match /musicCharts/{id} {
      allow read: if resource.data.published == true || isFounder();
      allow write: if isFounder();
    }
    match /musicChartEntries/{id} {
      allow read: if resource.data.published == true || isFounder();
      allow write: if isFounder();
    }
    // Sound On rotation, feature switches (Song Rate, Charts), TV channel, rating weights: public to read, founder to change.
    match /musicSettings/{id} {
      allow read: if true;
      allow write: if isFounder();
    }
    match /tvCategories/{id} {
      allow read: if true;
      allow write: if isFounder();
    }
    // Song Rate reviews (scores, private notes): founder only. Submissions themselves are stored privately in R2.
    match /songReviews/{id} {
      allow read, write: if isFounder();
    }

    // ---------- Content Studio ----------
    // Founder/HNIC plus accounts the founder lists in contentRoles. Only the founder approves, schedules or publishes,
    // edits brand kits, and manages who has access.
    function contentMember() {
      return signedIn() && exists(/databases/$(database)/documents/contentRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/contentRoles/$(request.auth.uid)).data.role in ["editor", "manager"];
    }
    function contentAccess() { return isFounder() || contentMember(); }
    match /contentRoles/{uid} {
      allow read: if isFounder() || (signedIn() && request.auth.uid == uid);
      allow write: if isFounder();
    }
    match /contentBrands/{id} {
      allow read: if contentAccess();
      allow write: if isFounder();
    }
    match /contentPosts/{id} {
      allow read: if contentAccess();
      allow create, update: if isFounder() || (contentMember() && request.resource.data.status in ["generated", "draft", "pending", "rejected"]);
      allow delete: if isFounder();
    }
    match /contentCampaigns/{id} {
      allow read, write: if contentAccess();
    }
    match /contentTrends/{id} {
      allow read, write: if contentAccess();
    }
    match /contentLog/{id} {
      allow read, create: if contentAccess();
      allow update, delete: if isFounder();
    }

    // ---------- Groove Guide ----------
    // Each signed-in person's saved places, vehicle, trips and walks. Only that person can read or change them.
    match /guide/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---------- Website Studio ----------
    // Draft site (unpublished text, layout and image choices): founder or HNIC only. The public reads settings/site.
    match /sitedraft/{doc} {
      allow read, write: if isFounder();
    }
    // Published versions: founder reads and adds; history can never be edited or deleted (audit trail).
    match /siteversions/{v} {
      allow read, create: if isFounder();
      allow update, delete: if false;
    }
    // Media Library records (file names, folders, alt text). The files themselves sit in R2 behind the Worker,
    // which only serves files that belong to the published site.
    match /mediaLib/{id} {
      allow read, write: if isFounder();
    }

    // Website images and links (Back office › Website): everyone can see them, only the founder or HNIC changes them
    match /media/{id} {
      allow read: if true;
      allow write: if isFounder();
    }

    // Shadow Crown: Living World saves. Each player reads and writes only their own save.
    match /scsave/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // Shadow Crown player cards (name, level, location, friend code). Signed-in players can look them up by code.
    match /scplayers/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["code", "name", "level", "loc", "mission", "updatedAt"]);
    }

    // Calendar: public events are visible to everyone, private events only to the founder
    match /events/{id} {
      allow read: if resource.data.visibility == "public" || isFounder();
      allow write: if isFounder();
    }

    // Groove Guide event images (flyer, venue photo): readable when the event is public, written by the founder
    match /eventMedia/{id} {
      allow read: if isFounder() || get(/databases/$(database)/documents/events/$(id)).data.visibility == "public";
      allow write: if isFounder();
    }

    // Company heads list: everyone signed in can read it, only the founder changes it
    match /org/{doc} {
      allow read: if signedIn();
      allow write: if isFounder();
    }

    // Join requests: each person writes their own; heads and the founder can read them
    match /requests/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isFounder() || isAnyHead());
      allow write: if signedIn() && (request.auth.uid == uid || isFounder());
    }

    // Approvals: written under the approver's own id, only for a company they head
    match /grants/{author}/to/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == author
        && (isFounder() || isHeadOf(request.resource.data.brand));
      allow delete: if isFounder()
        || (signedIn() && request.auth.uid == author && isHeadOf(resource.data.brand));
    }

    // Founder role, plus a copy of which companies each person heads. Only the founder can change it.
    match /access/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isFounder());
      allow write: if isFounder();
    }

    // Each team member's private timesheet
    match /memberlog/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isFounder());
      allow create, update: if signedIn() && (request.auth.uid == uid || isFounder());
      allow delete: if isFounder();

      match /entries/{id} {
        allow read, delete: if signedIn() && (request.auth.uid == uid || isFounder());
        allow create, update: if signedIn() && (request.auth.uid == uid || isFounder());
      }
      match /receipts/{id} {
        allow read, write: if signedIn() && (request.auth.uid == uid || isFounder());
      }
    }

    // Everything else (founder timesheet, receipts, reminders, collabs, private notes): founder only
    match /{collection}/{id} {
      allow read, write: if isFounder();
    }
  }
}
