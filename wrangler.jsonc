// Cloudflare Worker for grooveville.org.
// "name" must match your Worker's name in the Cloudflare dashboard (Workers & Pages › grooveville).
{
  "name": "grooveville",
  "main": "worker/index.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Private storage for Studio recordings, clip exports and the cached YouTube sync.
  // Create this bucket first: R2 › Create bucket › grooveville-studio
  "r2_buckets": [
    { "binding": "STUDIO_BUCKET", "bucket_name": "grooveville-studio" }
  ],
  // Grooveville Rentals + Entertainment database (Cloudflare D1). Wrangler 4.45+ creates it automatically on
  // the first deploy when no database_id is given. If your deploy log says otherwise, create a D1 database named
  // grooveville-portal (Storage & Databases › D1) and paste its ID here as "database_id". Tables are created by the Worker.
  "d1_databases": [{ "binding": "PORTAL_DB", "database_name": "grooveville-portal" }],
  // Content Autopilot background jobs. Create this queue once before deploying:
  // Cloudflare dashboard › Storage & Databases › Queues › Create queue › name: grooveville-autopilot
  "queues": {
    "producers": [{ "binding": "AUTOPILOT_Q", "queue": "grooveville-autopilot" }],
    "consumers": [{ "queue": "grooveville-autopilot", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 3 }]
  },
  // Cloudflare Images assembles finished Autopilot graphics (photo + official logo + exact text). Nothing to create.
  "images": { "binding": "IMAGES" },
  // Every 2 minutes: checks YouTube (and Twitch, if connected) and starts Content Autopilot when work is due.
  "triggers": { "crons": ["*/2 * * * *"] },
  "vars": {
    "FIREBASE_PROJECT_ID": "groovevillellc",
    "R2_BUCKET_NAME": "grooveville-studio",
    "SITE_URL": "https://grooveville.org"
  },
  // Keep variables you add in the dashboard. Secrets (YOUTUBE_API_KEY, R2 keys) are never stored in this file.
  "keep_vars": true,
  "observability": { "enabled": true }
}
