// Cloudflare Worker for grooveville.org.
// "name" must match your Worker's name in the Cloudflare dashboard (Workers & Pages › grooveville).
{
  "name": "grooveville",
  "main": "worker/index.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/artist/*"]
  },
  // Private storage for Studio recordings, clip exports and the cached YouTube sync.
  // Create this bucket first: R2 › Create bucket › grooveville-studio
  "r2_buckets": [
    { "binding": "STUDIO_BUCKET", "bucket_name": "grooveville-studio" }
  ],
  // Checks YouTube (and Twitch, if connected) every 2 minutes.
  "triggers": { "crons": ["*/2 * * * *"] },
  "vars": {
    "FIREBASE_PROJECT_ID": "groovevillellc",
    "R2_BUCKET_NAME": "grooveville-studio"
  },
  // Keep variables you add in the dashboard. Secrets (YOUTUBE_API_KEY, R2 keys) are never stored in this file.
  "keep_vars": true,
  "observability": { "enabled": true }
}
